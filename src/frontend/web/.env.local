# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_AMPLITUDE_KEY=

# External Services
NEXT_PUBLIC_OPENAI_API_KEY=your-key-here
NEXT_PUBLIC_HUGGINGFACE_TOKEN=your-token-here